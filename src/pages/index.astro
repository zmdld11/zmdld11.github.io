---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { site, socials, weather, widgets } from "../config/site";
import { excerpt, fmtDate } from "../lib/post-utils";
import contributions from "../data/contributions.json";
import eventsRaw from "../data/events.json";
import bangumi from "../data/bangumi.json";
import { CARDS } from "../lib/cards";
import { mapEvents, relTime } from "../lib/github-events";

const posts = (
  await getCollection("posts", ({ data }) => !data.draft && !data.hidden)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts.slice(0, 2);

// 构建期预取的公开动态（初始数据，客户端再尝试刷新）
const events = mapEvents(eventsRaw.events).map((e) => ({ ...e, time: relTime(e.iso) }));
---

<SiteLayout title={`${site.title} · ${site.subtitle}`} description={site.subtitle}>
  <script type="application/json" id="contrib-data" set:html={JSON.stringify(contributions.days)} />
  <section class="bento">
    <!-- 身份卡（右上角：当月贡献迷你格） -->
    <article class="card card-hover sp4 identity" data-card-id="identity">
      <div class="id-top">
        <div class="avatar accent-text">Z</div>
        {
          widgets.contributions && contributions.days.length > 0 && (
            <div class="contrib-mini">
              <div class="contrib-grid" id="contrib-mini" />
              <span class="contrib-label">
                本月 <b id="contrib-count">
                  {contributions.days
                    .filter((d) => d.date.startsWith(new Date().toISOString().slice(0, 7)))
                    .reduce((s, d) => s + d.count, 0)}
                </b> 次贡献
              </span>
            </div>
          )
        }
      </div>
      <h1>{site.author}</h1>
      <p class="bio">{site.subtitle}</p>
      <div class="row">
        {
          socials.map((s) => (
            <a class="chip" href={s.url} target="_blank" rel="noopener">
              {s.label}
            </a>
          ))
        }
      </div>
    </article>

    <!-- 时钟 -->
    {
      widgets.clock && (
        <article class="card card-hover sp4 clock" data-card-id="clock">
          <header class="card-head">现在</header>
          <div class="time" id="home-clock">--:--:--</div>
          <p class="date" id="home-date">载入中…</p>
        </article>
      )
    }

    <!-- 日历（农历 + 节日/节气） -->
    {
      widgets.calendar && (
        <article class="card card-hover sp4 calendar" data-card-id="calendar">
          <header class="card-head" id="home-cal-head">日历</header>
          <div class="cal-grid" id="home-cal"></div>
        </article>
      )
    }

    <!-- GitHub 公开动态：构建期预取初始数据，客户端缓存/ETag 刷新 -->
    {
      widgets.githubActivity && (
        <article class="card card-hover sp6 github" data-card-id="github">
          <header class="card-head">
            GitHub 动态
            <a class="more" href="https://github.com/zmdld11" target="_blank" rel="noopener">
              @zmdld11 →
            </a>
          </header>
          <ul class="github-list" id="gh-events">
            {events.length ? (
              events.map((e) => (
                <li>
                  <span class="icon">{e.icon}</span>
                  <span class="text">{e.text}</span>
                  <span class="time">{e.time}</span>
                </li>
              ))
            ) : (
              <li class="loading muted">近期没有公开动态</li>
            )}
          </ul>
        </article>
      )
    }

    <!-- 最新文章（真实数据） -->
    <article class="card card-hover sp6 posts" data-card-id="posts">
      <header class="card-head">最新文章 <a class="more" href="/archive/">全部 →</a></header>
      {
        latest.map((p) => (
          <a class="post" href={`/posts/${p.id}/`}>
            <div class="post-cover accent-text" aria-hidden="true">✦</div>
            <div class="post-body">
              <h3>{p.data.title}</h3>
              <p>{p.data.description || excerpt(p.body ?? "")}</p>
              <span class="meta">{fmtDate(p.data.pubDate)} · {p.data.category ?? p.data.tags[0] ?? "随笔"}</span>
            </div>
          </a>
        ))
      }
    </article>

    <!-- 音乐播放器（歌单：settings/music.json 可切网易云歌单/本地 playlist.json，与右下角迷你条联动） -->
    {
      widgets.musicPlayer && (
        <article class="card card-hover sp4 music" data-card-id="music">
          <header class="card-head">正在播放</header>
          <div class="player">
            <div class="cover accent-text">♪</div>
            <div class="track">
              <strong id="card-title">…</strong>
              <span class="muted" id="card-artist">…</span>
              <div class="bar" id="card-bar" title="点击跳转进度">
                <i id="card-bar-fill"></i>
              </div>
              <span class="timecode muted" id="card-time">0:00 / 0:00</span>
            </div>
            <div class="controls">
              <button id="card-prev" aria-label="上一首">⏮</button>
              <button class="play" id="card-play" aria-label="播放/暂停">▶</button>
              <button id="card-next" aria-label="下一首">⏭</button>
            </div>
          </div>
        </article>
      )
    }

    <!-- 一言（hitokoto） -->
    {
      widgets.hitokoto && (
        <article class="card card-hover sp4 hitokoto" data-card-id="hitokoto">
          <header class="card-head">一言</header>
          <blockquote id="hitokoto-text">“我们听取所有的声音，然后走自己选的路。”</blockquote>
          <span class="muted" id="hitokoto-from">—— 佚名</span>
        </article>
      )
    }

    <!-- 天气（Open-Meteo 免 key 直连；失败自动隐藏，成功前先藏住避免空卡闪烁） -->
    {
      widgets.weather && (
        <article class="card card-hover sp4 wx" data-card-id="weather" hidden>
          <header class="card-head">
            天气
            <span class="muted wx-city" id="wx-city">{weather.city}</span>
          </header>
          <div class="wx-body">
            <div class="wx-icon accent-text" id="wx-icon">⛅</div>
            <div class="wx-main">
              <div class="wx-temp"><b id="wx-temp">–</b>°C</div>
              <span class="muted" id="wx-desc">获取中…</span>
            </div>
          </div>
          <p class="muted wx-extra" id="wx-extra"></p>
        </article>
      )
    }

    <!-- 每日诗词（jinrishici，失败保持占位句） -->
    {
      widgets.poem && (
        <article class="card card-hover sp4 poem" data-card-id="poem">
          <header class="card-head">每日诗词</header>
          <blockquote id="poem-text">“山中何事？松花酿酒，春水煎茶。”</blockquote>
          <span class="muted" id="poem-from">—— 张可久《人月圆》</span>
        </article>
      )
    }

    <!-- 命理小馆入口（独立站，自托管在阿里云；排盘全在浏览器本地算） -->
    {
      widgets.fortune && (
        <article class="card card-hover sp4 fortune-card" data-card-id="fortune">
          <header class="card-head">
            命理小馆
            <a class="more" href="http://101.133.134.164:8787" target="_blank" rel="noopener">去算一卦 →</a>
          </header>
          <p class="fortune-line">
            <span class="fortune-icons">🔮 🪙 🃏</span>
            星盘 · 八字 · 紫微 · 六爻 · 塔罗，本地精确排盘，AI 只管解读。
          </p>
        </article>
      )
    }

    <!-- 统计（文章数真实；访客不蒜子；运行天数自建站日起） -->
    <article class="card card-hover sp4 stats" data-card-id="stats" data-since={site.sinceDate}>
      <header class="card-head">小站统计</header>
          <div class="stat-row">
        <div><b>{posts.length}</b><span class="muted">文章</span></div>
        <div><b id="stat-uv">–</b><span class="muted">访客</span></div>
        <div><b id="stat-days">–</b><span class="muted">运行天数</span></div>
      </div>
    </article>

    <!-- 追番·在看（Bangumi 构建期同步；无数据不渲染） -->
    {
      widgets.bangumi && bangumi.items.length > 0 && (
        <article class="card card-hover sp6 bangumi" data-card-id="bangumi">
          <header class="card-head">
            追番 · 在看
            <a class="more" href={`https://bgm.tv/user/${bangumi.uid}`} target="_blank" rel="noopener">
              Bangumi →
            </a>
          </header>
          <div class="bgm-strip">
            {bangumi.items.map((it) => (
              <a class="bgm-item" href={it.href} target="_blank" rel="noopener" title={it.nameCn || it.name}>
                <img src={it.cover} alt={it.nameCn || it.name} loading="lazy" width="64" height="90" />
                <span>{it.nameCn || it.name}</span>
              </a>
            ))}
          </div>
        </article>
      )
    }

    <!-- 卡片商店入口（虚线 ghost 卡） -->
    <button class="card ghost-card sp6" id="store-open" type="button">
      <span class="ghost-plus accent-text">＋</span>
      <span class="ghost-label">添加卡片</span>
      <span class="muted ghost-hint">从卡片商店启用组件</span>
    </button>
  </section>

  <!-- 卡片商店弹窗 -->
  <div class="store-overlay" id="store-overlay" hidden>
    <div class="store card" role="dialog" aria-modal="true" aria-label="卡片商店">
      <header class="card-head">
        卡片商店
        <button class="store-close" id="store-close" type="button" aria-label="关闭商店">✕</button>
      </header>
      <p class="muted store-hint">开关只在当前浏览器生效，恢复默认可清除记录。</p>
      <div class="store-list">
        {
          CARDS.map((c) => (
            <label class="store-item">
              <span class="s-icon">{c.icon}</span>
              <span class="s-body">
                <b>{c.name}</b>
                <span class="muted">{c.desc}</span>
              </span>
              <input type="checkbox" class="store-toggle" data-store-id={c.id} />
              <i class="s-switch" aria-hidden="true" />
            </label>
          ))
        }
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  import { Solar } from "lunar-typescript";
  import { BlogPlayer } from "../scripts/media-player";
  import { mapEvents, relTime } from "../lib/github-events";
  import { cardOn, cardPrefs, applyCards, CARD_STORE_KEY } from "../lib/cards";
  import { site, weather } from "../config/site";

  const fmt = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;

  /* ---- 卡片商店：先应用启停，再挂商店弹窗逻辑 ---- */
  applyCards();
  const storeOverlay = document.getElementById("store-overlay");
  const storeOpen = document.getElementById("store-open");
  const storeClose = document.getElementById("store-close");
  if (storeOverlay && storeOpen) {
    const syncToggles = () => {
      const prefs = cardPrefs();
      for (const input of storeOverlay.querySelectorAll("input[data-store-id]"))
        input.checked = prefs[input.dataset.storeId] ?? true;
    };
    syncToggles();
    storeOpen.addEventListener("click", () => {
      syncToggles();
      storeOverlay.hidden = false;
    });
    storeClose?.addEventListener("click", () => (storeOverlay.hidden = true));
    storeOverlay.addEventListener("click", (e) => {
      if (e.target === storeOverlay) storeOverlay.hidden = true;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") storeOverlay.hidden = true;
    });
    storeOverlay.addEventListener("change", (e) => {
      const input = e.target.closest("input[data-store-id]");
      if (!input) return;
      let saved = {};
      try {
        saved = JSON.parse(localStorage.getItem(CARD_STORE_KEY) ?? "{}");
      } catch {}
      saved[input.dataset.storeId] = input.checked;
      localStorage.setItem(CARD_STORE_KEY, JSON.stringify(saved));
      applyCards();
    });
  }

  /* ---- 时钟 ---- */
  const clockEl = document.getElementById("home-clock");
  const dateEl = document.getElementById("home-date");
  const tick = () => {
    const now = new Date();
    if (clockEl) clockEl.textContent = now.toLocaleTimeString("zh-CN", { hour12: false });
    if (dateEl)
      dateEl.textContent = now.toLocaleDateString("zh-CN", {
        year: "numeric",
        month: "long",
        day: "numeric",
        weekday: "long",
      });
  };
  if (clockEl) {
    tick();
    setInterval(tick, 1000);
  }

  /* ---- 当月日历（农历 + 节日/节气，周一起始） ---- */
  const calHead = document.getElementById("home-cal-head");
  const calGrid = document.getElementById("home-cal");
  if (calHead && calGrid) {
    const now = new Date();
    const y = now.getFullYear();
    const m = now.getMonth(); // 0-based
    calHead.textContent = `${y} 年 ${m + 1} 月`;
    const startCol = (new Date(y, m, 1).getDay() + 6) % 7;
    const days = new Date(y, m + 1, 0).getDate();
    const frag = document.createDocumentFragment();
    for (const w of ["一", "二", "三", "四", "五", "六", "日"]) {
      const s = document.createElement("span");
      s.className = "cal-head";
      s.textContent = w;
      frag.append(s);
    }
    for (let i = 0; i < startCol; i++)
      frag.append(Object.assign(document.createElement("span"), { className: "cal-day" }));
    for (let d = 1; d <= days; d++) {
      const solar = Solar.fromYmd(y, m + 1, d);
      const lunar = solar.getLunar();
      const festival =
        solar.getFestivals()[0] ?? lunar.getFestivals()[0] ?? lunar.getJieQi() ?? "";
      const label =
        festival || (lunar.getDay() === 1 ? lunar.getMonthInChinese() + "月" : lunar.getDayInChinese());
      const cell = document.createElement("span");
      cell.className = "cal-day" + (festival ? " festival" : "") + (d === now.getDate() ? " today" : "");
      const num = document.createElement("i");
      num.className = "d";
      num.textContent = String(d);
      const lab = document.createElement("i");
      lab.className = "l";
      lab.textContent = label;
      cell.append(num, lab);
      frag.append(cell);
    }
    calGrid.replaceChildren(frag);
  }

  /* ---- 播放器卡片（与右下角迷你条共用 BlogPlayer） ---- */
  const cardPlay = document.getElementById("card-play");
  const cardPrev = document.getElementById("card-prev");
  const cardNext = document.getElementById("card-next");
  const cardTitle = document.getElementById("card-title");
  const cardArtist = document.getElementById("card-artist");
  const cardBar = document.getElementById("card-bar");
  const cardBarFill = document.getElementById("card-bar-fill");
  const cardTime = document.getElementById("card-time");
  if (cardPlay && cardTitle) {
    const render = (st) => {
      cardPlay.textContent = st.playing ? "⏸" : "▶";
      cardTitle.textContent = st.track.title;
      if (cardArtist) cardArtist.textContent = st.track.artist ?? "";
      if (cardBarFill)
        cardBarFill.style.width = st.duration ? `${(st.currentTime / st.duration) * 100}%` : "0%";
      if (cardTime)
        cardTime.textContent = `${fmt(st.currentTime)} / ${fmt(st.duration)}`;
    };
    render(BlogPlayer.state());
    cardPlay.addEventListener("click", () => BlogPlayer.toggle());
    cardPrev?.addEventListener("click", () => BlogPlayer.prev());
    cardNext?.addEventListener("click", () => BlogPlayer.next());
    cardBar?.addEventListener("click", (e) => {
      const rect = cardBar.getBoundingClientRect();
      BlogPlayer.seek((e.clientX - rect.left) / rect.width);
    });
    window.addEventListener("blogplayer", (e) => render(e.detail));
  }

  /* ---- GitHub 公开动态：初始为构建期预取，这里做缓存/ETag 静默刷新 ---- */
  const ghList = document.getElementById("gh-events");
  if (ghList) {
    const CACHE_KEY = "gh-events-v1";
    const TTL = 30 * 60 * 1000;
    const render = (events) => {
      if (!events?.length) return;
      ghList.innerHTML = events
        .map(
          (e) =>
            `<li><span class="icon">${e.icon}</span><span class="text">${e.text}</span><span class="time">${relTime(e.iso)}</span></li>`,
        )
        .join("");
    };

    let cache = null;
    try {
      cache = JSON.parse(localStorage.getItem(CACHE_KEY));
    } catch {}
    if (cache?.events?.length && Date.now() - cache.t < TTL) render(cache.events);

    (async () => {
      if (!cardOn("github")) return; // 商店关闭时不发请求
      try {
        const headers = cache?.etag ? { "If-None-Match": cache.etag } : {};
        const res = await fetch(
          "https://api.github.com/users/zmdld11/events/public?per_page=30",
          { headers },
        );
        let events;
        if (res.status === 304 && cache?.events) events = cache.events;
        else if (res.ok) {
          events = mapEvents(await res.json());
          try {
            localStorage.setItem(
              CACHE_KEY,
              JSON.stringify({ t: Date.now(), etag: res.headers.get("etag"), events }),
            );
          } catch {}
        } else return;
        render(events);
      } catch {}
    })();
  }

  /* ---- 身份卡右上角：当月贡献迷你格（客户端按真实月份过滤渲染） ---- */
  const contribData = document.getElementById("contrib-data");
  const miniGrid = document.getElementById("contrib-mini");
  const miniCount = document.getElementById("contrib-count");
  if (contribData && miniGrid) {
    const days = JSON.parse(contribData.textContent);
    const now = new Date();
    const prefix = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
    const monthDays = days.filter((d) => d.date.startsWith(prefix));
    if (!monthDays.length) {
      miniGrid.closest(".contrib-mini")?.remove();
    } else {
      const frag = document.createDocumentFragment();
      const emptyCell = () => {
        const i = document.createElement("i");
        i.className = "e";
        return i;
      };
      const lead = new Date(monthDays[0].date + "T00:00:00").getDay(); // 周日起始对齐 GitHub 列
      for (let i = 0; i < lead; i++) frag.append(emptyCell());
      for (const d of monthDays) {
        const i = document.createElement("i");
        if (d.count > 0) i.style.background = d.color;
        i.title = `${d.date} · ${d.count} 次`;
        frag.append(i);
      }
      miniGrid.append(frag);
      if (miniCount)
        miniCount.textContent = String(monthDays.reduce((s, d) => s + d.count, 0));
    }
  }

  /* ---- 一言（hitokoto，失败保持占位句） ---- */
  const hitoText = document.getElementById("hitokoto-text");
  const hitoFrom = document.getElementById("hitokoto-from");
  if (hitoText && cardOn("hitokoto")) {
    const ctrl = new AbortController();
    setTimeout(() => ctrl.abort(), 3000);
    fetch("https://v1.hitokoto.cn/?max_length=24", { signal: ctrl.signal })
      .then((r) => r.json())
      .then((h) => {
        hitoText.textContent = `“${h.hitokoto}”`;
        if (hitoFrom) hitoFrom.textContent = `—— ${h.from_work ?? h.from ?? "佚名"}`;
      })
      .catch(() => {});
  }

  /* ---- 天气（Open-Meteo 免 key 直连；失败隐藏卡片） ---- */
  const wxCard = document.querySelector('[data-card-id="weather"]');
  const wxIcon = document.getElementById("wx-icon");
  if (wxCard && wxIcon && cardOn("weather")) {
    // WMO weather_code → 图标与文案
    const WMO = {
      0: ["☀️", "晴"], 1: ["🌤️", "大致晴朗"], 2: ["⛅", "多云"], 3: ["☁️", "阴"],
      45: ["🌫️", "有雾"], 48: ["🌫️", "雾凇"],
      51: ["🌦️", "小毛毛雨"], 53: ["🌦️", "毛毛雨"], 55: ["🌦️", "大毛毛雨"],
      61: ["🌧️", "小雨"], 63: ["🌧️", "中雨"], 65: ["🌧️", "大雨"],
      66: ["🌧️", "冻雨"], 67: ["🌧️", "冻雨"],
      71: ["🌨️", "小雪"], 73: ["🌨️", "中雪"], 75: ["🌨️", "大雪"], 77: ["🌨️", "米雪"],
      80: ["🌦️", "阵雨"], 81: ["🌦️", "阵雨"], 82: ["🌧️", "强阵雨"],
      85: ["🌨️", "阵雪"], 86: ["🌨️", "阵雪"],
      95: ["⛈️", "雷阵雨"], 96: ["⛈️", "雷雨伴冰雹"], 99: ["⛈️", "雷雨伴冰雹"],
    };
    fetch(
      `https://api.open-meteo.com/v1/forecast?latitude=${weather.lat}&longitude=${weather.lon}&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&timezone=auto`,
    )
      .then((r) => r.json())
      .then((d) => {
        const c = d?.current;
        if (!c) throw new Error("no data");
        const [icon, text] = WMO[c.weather_code] ?? ["🌡️", "未知"];
        wxIcon.textContent = icon;
        const t = document.getElementById("wx-temp");
        if (t) t.textContent = String(Math.round(c.temperature_2m));
        const desc = document.getElementById("wx-desc");
        if (desc) desc.textContent = text;
        const extra = document.getElementById("wx-extra");
        if (extra)
          extra.textContent = `湿度 ${c.relative_humidity_2m}% · 风速 ${Math.round(c.wind_speed_10m)} km/h`;
        if (cardOn("weather")) wxCard.hidden = false;
      })
      .catch(() => {
        wxCard.hidden = true;
      });
  }

  /* ---- 每日诗词（jinrishici，失败保持占位句） ---- */
  const poemText = document.getElementById("poem-text");
  if (poemText && cardOn("poem")) {
    fetch("https://v1.jinrishici.com/all.json")
      .then((r) => r.json())
      .then((d) => {
        if (!d?.content) return;
        poemText.textContent = `“${d.content}”`;
        const from = document.getElementById("poem-from");
        if (from) from.textContent = `—— ${d.author ?? "佚名"}《${d.origin ?? "无题"}》`;
      })
      .catch(() => {});
  }

  /* ---- 卡片布局编辑：右键 / 长按进入，也可从美化面板进入；拖拽排序 + 宽度切换 ---- */
  const bento = document.querySelector(".bento");
  if (bento) {
    const LAYOUT_KEY = "bento-layout-v1";
    const SPANS = ["sp4", "sp6", "sp12"];
    const ghost = document.getElementById("store-open");
    const cards = () => [...bento.querySelectorAll("[data-card-id]")];

    const applyLayout = () => {
      let saved = null;
      try {
        saved = JSON.parse(localStorage.getItem(LAYOUT_KEY) ?? "null");
      } catch {}
      if (!saved) return;
      const byId = Object.fromEntries(cards().map((el) => [el.dataset.cardId, el]));
      for (const id of saved.order ?? []) {
        if (byId[id]) bento.insertBefore(byId[id], ghost ?? null);
      }
      if (ghost) bento.appendChild(ghost); // ghost 恒居末尾
      for (const [id, span] of Object.entries(saved.span ?? {})) {
        const el = byId[id];
        if (el && SPANS.includes(span)) {
          el.classList.remove(...SPANS);
          el.classList.add(span);
        }
      }
    };
    applyLayout();

    let editing = false;
    const saveLayout = () => {
      const span = {};
      for (const el of cards()) {
        span[el.dataset.cardId] = SPANS.find((s) => el.classList.contains(s)) ?? "sp4";
      }
      localStorage.setItem(
        LAYOUT_KEY,
        JSON.stringify({ order: cards().map((el) => el.dataset.cardId), span }),
      );
    };

    const doneBar = document.createElement("div");
    doneBar.className = "layout-done card";
    doneBar.hidden = true;
    doneBar.innerHTML = `<span>拖拽卡片调位置，右上「宽度」改大小</span><button type="button" class="btn">完成</button>`;
    doneBar.querySelector("button").addEventListener("click", () => {
      saveLayout();
      setEdit(false);
    });
    document.body.append(doneBar);

    function setEdit(on) {
      editing = on;
      bento.classList.toggle("editing", on);
      doneBar.hidden = !on;
      for (const el of cards()) {
        el.draggable = on;
        let btn = el.querySelector(".span-cycle");
        if (on && !btn) {
          btn = document.createElement("button");
          btn.type = "button";
          btn.className = "span-cycle";
          btn.textContent = "宽度";
          btn.title = "切换宽度：中 → 宽 → 整行 → 中";
          btn.addEventListener("click", () => {
            const nextSpan =
              el.classList.contains("sp6") ? "sp12" : el.classList.contains("sp12") ? "sp4" : "sp6";
            el.classList.remove(...SPANS);
            el.classList.add(nextSpan);
          });
          el.append(btn);
        } else if (!on && btn) btn.remove();
      }
    }

    // 右键进入；移动端长按 500ms 进入（移动不算拖动才触发）
    bento.addEventListener("contextmenu", (e) => {
      if (editing || !e.target.closest("[data-card-id]")) return;
      e.preventDefault();
      setEdit(true);
    });
    let pressTimer;
    bento.addEventListener("pointerdown", (e) => {
      if (editing || !e.pointerType.match(/touch|pen/) || !e.target.closest("[data-card-id]")) return;
      const x = e.clientX;
      const y = e.clientY;
      const cancel = (ev) => {
        if (Math.hypot(ev.clientX - x, ev.clientY - y) > 10) clearTimeout(pressTimer);
      };
      pressTimer = setTimeout(() => setEdit(true), 500);
      bento.addEventListener("pointermove", cancel, { once: true });
      bento.addEventListener("pointerup", () => clearTimeout(pressTimer), { once: true });
      bento.addEventListener("pointercancel", () => clearTimeout(pressTimer), { once: true });
    });
    window.addEventListener("open-card-editor", () => setEdit(true));

    // 拖拽排序（编辑模式下启用 HTML5 DnD，按横向中点判定插入位）
    bento.addEventListener("dragstart", (e) => {
      const card = e.target.closest?.("[data-card-id]");
      if (!card || !editing) {
        e.preventDefault();
        return;
      }
      e.dataTransfer.setData("text/plain", card.dataset.cardId);
      card.classList.add("dragging");
    });
    bento.addEventListener("dragend", (e) => {
      e.target.closest?.("[data-card-id]")?.classList.remove("dragging");
    });
    bento.addEventListener("dragover", (e) => {
      if (!editing) return;
      e.preventDefault();
      const dragging = bento.querySelector(".dragging");
      const over = e.target.closest("[data-card-id]");
      if (!dragging || !over || over === dragging) return;
      const rect = over.getBoundingClientRect();
      bento.insertBefore(dragging, e.clientX < rect.left + rect.width / 2 ? over : over.nextSibling);
    });
  }

  /* ---- 运行天数 ---- */
  const daysEl = document.getElementById("stat-days");
  const statsCard = document.querySelector<HTMLElement>(".stats[data-since]");
  if (daysEl && statsCard) {
    const since = new Date(statsCard.dataset.since ?? "");
    daysEl.textContent = String(
      Math.max(1, Math.floor((Date.now() - since.getTime()) / 86400000)),
    );
  }
</script>

<script>
  // 不蒜子回调较慢：把 UV 同步到统计卡（footer 的 PV 由 busuanzi 直接填充）
  window.addEventListener("load", () => {
    const uv = document.getElementById("stat-uv");
    const src = document.getElementById("busuanzi_value_site_uv");
    if (!uv || !src) return;
    let tries = 0;
    const timer = setInterval(() => {
      if (src.textContent && src.textContent !== "–") {
        uv.textContent = src.textContent;
        clearInterval(timer);
      } else if (++tries > 20) clearInterval(timer);
    }, 500);
  });
</script>


---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { fmtDate } from "../lib/post-utils";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.pubDate.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<SiteLayout title={`归档 · 文章 ${posts.length} 篇`}>
  <section class="page-card card">
    <h1>归档</h1>
    <p class="muted">共 {posts.length} 篇 · 持续更新中</p>
    {
      years.map((y) => (
        <div class="year">
          <h2>{y} <span class="muted">({byYear.get(y)!.length})</span></h2>
          {byYear.get(y)!.map((p) => (
            <a class="row" href={`/posts/${p.id}/`}>
              <span class="date">{fmtDate(p.data.pubDate).slice(5)}</span>
              <span class="title">{p.data.title}</span>
              <span class="tags">{p.data.category ?? p.data.tags[0] ?? ""}</span>
            </a>
          ))}
        </div>
      ))
    }
  </section>
</SiteLayout>

<style>
  .page-card { padding: 34px 36px; max-width: 820px; margin: 0 auto; }
  h1 { margin: 0 0 8px; font-size: 26px; }
  .muted { color: var(--text-muted); font-weight: 400; font-size: 13.5px; }
  p.muted { margin: 0 0 24px; }
  .year h2 {
    font-size: 19px;
    margin: 26px 0 10px;
    padding-left: 10px;
    border-left: 4px solid var(--accent);
  }
  .year:first-of-type h2 { margin-top: 0; }
  .row {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 10px 6px;
    border-radius: var(--radius-sm);
  }
  .row:hover { background: var(--accent-soft); }
  .date { flex: none; font-size: 12.5px; color: var(--text-faint); font-variant-numeric: tabular-nums; }
  .title { flex: 1; min-width: 0; font-size: 14.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .row:hover .title { color: var(--accent); }
  .tags { flex: none; font-size: 11.5px; color: var(--text-muted); }

  @media (max-width: 640px) {
    .page-card { padding: 24px 20px; }
    .tags { display: none; }
  }
</style>

---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { excerpt, fmtDate } from "../../lib/post-utils";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = new Set<string>();
  for (const p of posts) {
    for (const t of [...p.data.tags, ...(p.data.category ? [p.data.category] : [])]) tags.add(t);
  }
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag) || p.data.category === tag)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<SiteLayout title={`#${tag} · 标签`}>
  <section class="page-card card">
    <h1>#{tag}</h1>
    <p class="muted">{posts.length} 篇文章</p>
    <div class="list">
      {
        posts.map((p) => (
          <a class="row" href={`/posts/${p.id}/`}>
            <div class="body">
              <strong>{p.data.title}</strong>
              <p>{p.data.description || excerpt(p.body ?? "")}</p>
            </div>
            <span class="date">{fmtDate(p.data.pubDate)}</span>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .page-card { padding: 34px 36px; max-width: 820px; margin: 0 auto; }
  h1 { margin: 0 0 8px; font-size: 26px; }
  .muted { color: var(--text-muted); font-size: 13.5px; margin: 0 0 20px; }
  .list { display: flex; flex-direction: column; }
  .row {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 16px 4px;
    border-bottom: 1px dashed var(--card-border);
  }
  .row:last-child { border-bottom: none; }
  .body { flex: 1; min-width: 0; }
  .row strong { font-size: 15.5px; transition: color 0.2s; }
  .row:hover strong { color: var(--accent); }
  .row p {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .date { flex: none; font-size: 12.5px; color: var(--text-faint); font-variant-numeric: tabular-nums; }

  @media (max-width: 640px) {
    .page-card { padding: 24px 20px; }
    .row { flex-direction: column; gap: 4px; }
  }
</style>

---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of [...p.data.tags, ...(p.data.category ? [p.data.category] : [])]) {
    counts.set(t, (counts.get(t) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<SiteLayout title={`标签 · 云端小站`}>
  <section class="page-card card">
    <h1>标签</h1>
    <p class="muted">共 {tags.length} 个标签 · {posts.length} 篇文章</p>
    <div class="cloud">
      {
        tags.map(([tag, n]) => (
          <a class="chip" href={`/tags/${tag}/`}>
            #{tag} <b>{n}</b>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .page-card { padding: 34px 36px; max-width: 820px; margin: 0 auto; }
  h1 { margin: 0 0 8px; font-size: 26px; }
  .muted { color: var(--text-muted); font-size: 13.5px; margin: 0 0 24px; }
  .cloud { display: flex; flex-wrap: wrap; gap: 10px; }
  .cloud b { color: var(--text-faint); font-weight: 500; font-size: 11px; }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";

/* 设计稿 V4 —— 终端极客（等宽字体 / 终端窗口 / 数据流） */

// cal 样例：2026 年 9 月（周一开头），today=24
const first = new Date(2026, 8, 1);
const startCol = (first.getDay() + 6) % 7;
const daysInMonth = new Date(2026, 9, 0).getDate();
const cells = [
  ...Array.from({ length: startCol }, () => 0),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
const today = 24;

const gitLog = [
  { hash: "a1b2c3f", msg: "feat: 新增量化系统入口", repo: "MyBlog", when: "2h ago" },
  { hash: "9d8e7f6", msg: "docs: 更新 README", repo: "MyBlog", when: "2h ago" },
  { hash: "5c4b3a2", msg: "issue#12: 拆分 ci.yml", repo: "dev-workflow", when: "1d ago" },
  { hash: "1f2e3d4", msg: "chore: bump deps", repo: "dev-workflow", when: "2d ago" },
  { hash: "77aa00c", msg: "init: create repo", repo: "potato-sync", when: "3d ago" },
];

const fileLogs = [
  { date: "2026-09-24", name: "rebuild-blog-with-astro.md", size: "6.2k" },
  { date: "2026-09-12", name: "quant-dashboard-notes.md", size: "11k" },
  { date: "2026-03-08", name: "street-photography-101.md", size: "8.4k" },
  { date: "2026-02-02", name: "shokax-config-legacy.md", size: "3.1k" },
];

const nav = [
  { label: "V1 玻璃Bento", href: "/preview/v1" },
  { label: "V2 杂志", href: "/preview/v2" },
  { label: "V3 软糖", href: "/preview/v3" },
  { label: "V4 终端", href: "/preview/v4", current: true },
];
---

<BaseLayout title={`V4 终端 · ${site.title}`} colorScheme="dark" previewNav={nav}>
  <div class="page">
    <main class="wrap">
      <!-- 终端标题栏 -->
      <div class="term card">
        <div class="titlebar">
          <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
          <span class="title">zmdld11@blog: ~</span>
        </div>

        <div class="body">
          <p class="line"><span class="prompt">$</span> whoami</p>
          <h1 class="whoami">{site.author} <span class="cursor">▊</span></h1>
          <p class="line typed-line">
            <span class="prompt">$</span>
            <span class="typed">写字、造轮子、记录生活 —— 欢迎来到我的数字据点。</span>
          </p>

          <div class="grid">
            <!-- git log -->
            <section class="win sp6">
              <p class="win-title">tail -f /var/log/github.log <span class="badge">样例</span></p>
              <ul class="log">
                {
                  gitLog.map((e) => (
                    <li>
                      <span class="hash">* {e.hash}</span>
                      <span class="msg">{e.msg}</span>
                      <span class="repo">[{e.repo}]</span>
                      <span class="when">{e.when}</span>
                    </li>
                  ))
                }
              </ul>
            </section>

            <!-- 文件列表 -->
            <section class="win sp6">
              <p class="win-title">ls -lt ~/posts</p>
              <ul class="log">
                {
                  fileLogs.map((f) => (
                    <li>
                      <span class="perm">-rw-r--r--</span>
                      <span class="fdate">{f.date}</span>
                      <a class="fname" href="/">{f.name}</a>
                      <span class="when">{f.size}</span>
                    </li>
                  ))
                }
              </ul>
            </section>

            <!-- cal -->
            <section class="win sp4">
              <p class="win-title">cal</p>
              <div class="cal">
                <span class="cal-title">   九月 2026</span>
                {["一","二","三","四","五","六","日"].map((d) => <span class="h">{d}</span>)}
                {cells.map((d) => (
                  <span class:list={["d", { today: d === today, empty: d === 0 }]}>{d === 0 ? " " : d}</span>
                ))}
              </div>
            </section>

            <!-- 播放器 -->
            <section class="win sp8">
              <p class="win-title">ncmpc —— now playing <span class="badge">样例</span></p>
              <p class="np">♪ Sample Track —— 未知艺术家</p>
              <p class="ascii-bar">[<span class="fill">######</span><span class="rest">········</span>] 01:24/04:05</p>
              <p class="keys"><span>⏮ prev</span><span>⏸ pause</span><span>⏭ next</span><span>🔁 random</span></p>
            </section>

            <!-- 资源监控风统计 -->
            <section class="win sp7">
              <p class="win-title">blog-stats <span class="badge">样例</span></p>
              <p class="stat"><span>文章</span><span class="trackbar"><i style="width:52%"></i></span><b>20</b></p>
              <p class="stat"><span>访客</span><span class="trackbar"><i style="width:74%"></i></span><b>1,024</b></p>
              <p class="stat"><span>运行天数</span><span class="trackbar"><i style="width:88%"></i></span><b>212</b></p>
            </section>

            <!-- 一言 -->
            <section class="win sp5">
              <p class="win-title">fortune</p>
              <p class="fortune"><span class="comment"># 一言 · 样例</span><br />“我们听取所有的声音，然后走自己选的路。”</p>
            </section>

            <!-- 服务/外链 -->
            <section class="win sp12">
              <p class="win-title">services</p>
              <div class="links">
                <a class="svc" href="https://github.com/zmdld11">[github:zmdld11] <span class="ok">● online</span></a>
                <a class="svc" href="http://101.133.134.164:8000">[quant-dashboard] <span class="warn">● http-only</span></a>
                <span class="svc">[rss:/feed.xml] <span class="warn">● pending</span></span>
              </div>
            </section>
          </div>

          <p class="line exit"><span class="prompt">$</span> <span class="muted">exit<span class="cursor">▊</span></span></p>
        </div>
      </div>

      <footer class="foot">© 2026 {site.author} · 样例设计稿 V4 · 数据均为占位</footer>
    </main>
  </div>
</BaseLayout>

<style>
  /* 终端风令牌覆盖 */
  .page {
    --bg: #070b09;
    --card: rgba(13, 20, 16, 0.88);
    --card-border: rgba(52, 211, 153, 0.16);
    --text: #c9e8d8;
    --text-muted: #6f9c86;
    --text-faint: #48705d;
    --accent: #34d399;
    --accent-2: #fbbf24;
    --accent-soft: rgba(52, 211, 153, 0.08);
    --shadow: none;
    --card-blur: 0px;
    --radius-lg: 10px;
    --radius-md: 8px;
    --radius-sm: 6px;

    min-height: 100vh;
    font-family: var(--font-mono);
    background-image:
      linear-gradient(rgba(52, 211, 153, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(52, 211, 153, 0.04) 1px, transparent 1px);
    background-size: 34px 34px;
  }

  .page :global(.card) { box-shadow: none; }

  .wrap { max-width: 1100px; margin: 0 auto; padding: 30px 22px 80px; }

  .term { overflow: hidden; }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--card-border);
    background: rgba(52, 211, 153, 0.05);
  }
  .dot { width: 11px; height: 11px; border-radius: 50%; }
  .red { background: #f87171; }
  .yellow { background: #fbbf24; }
  .green { background: #34d399; }
  .title { margin-left: 10px; font-size: 12.5px; color: var(--text-muted); }

  .body { padding: 24px; }

  .line { font-size: 13.5px; margin: 0 0 6px; }
  .prompt { color: var(--accent); font-weight: 700; }
  .whoami { font-size: clamp(26px, 4vw, 38px); margin: 2px 0 18px; letter-spacing: 0.02em; }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .typed {
    color: var(--text-muted);
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: none;
    max-width: 0;
    animation: typing 2.6s steps(30, end) 0.4s forwards;
  }
  @keyframes typing { to { max-width: 100%; } }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 14px;
    margin: 22px 0;
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
  .sp4, .sp5, .sp6, .sp7, .sp8, .sp12 { grid-column: span 12; }
  @media (min-width: 900px) {
    .sp4 { grid-column: span 4; }
    .sp5 { grid-column: span 5; }
    .sp6 { grid-column: span 6; }
    .sp7 { grid-column: span 7; }
    .sp8 { grid-column: span 8; }
    .sp12 { grid-column: span 12; }
  }

  .win {
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    background: rgba(52, 211, 153, 0.03);
    transition: border-color 0.2s;
  }
  .win:hover { border-color: rgba(52, 211, 153, 0.45); }
  .win-title {
    margin: 0 0 12px;
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.06em;
  }
  .badge {
    font-size: 10px;
    padding: 1px 6px;
    border: 1px solid var(--card-border);
    border-radius: 4px;
    color: var(--text-faint);
    letter-spacing: 0.15em;
  }

  .log { list-style: none; margin: 0; padding: 0; font-size: 12.5px; }
  .log li {
    display: flex;
    gap: 12px;
    padding: 5px 0;
    border-bottom: 1px dashed rgba(52, 211, 153, 0.1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .log li:last-child { border-bottom: none; }
  .hash { color: var(--accent); flex: none; }
  .msg { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .repo { color: var(--accent-2); flex: none; }
  .when, .perm, .fdate { color: var(--text-faint); flex: none; }
  .fname { color: var(--text); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .fname:hover { color: var(--accent); }

  /* cal */
  .cal {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    font-size: 11.5px;
    text-align: center;
  }
  .cal-title { grid-column: 1 / -1; color: var(--accent); margin-bottom: 4px; }
  .h { color: var(--text-faint); }
  .d { color: var(--text-muted); padding: 2px 0; }
  .d.today { background: var(--accent); color: #05130c; font-weight: 700; border-radius: 3px; }

  /* 播放器 */
  .np { margin: 0 0 8px; font-size: 13.5px; }
  .ascii-bar { margin: 0 0 10px; font-size: 13px; letter-spacing: 1px; }
  .fill { color: var(--accent); }
  .rest { color: var(--text-faint); }
  .keys { margin: 0; display: flex; gap: 16px; font-size: 11.5px; color: var(--text-muted); }

  /* 统计 */
  .stat { display: flex; align-items: center; gap: 12px; margin: 0 0 10px; font-size: 12.5px; }
  .stat span:first-child { flex: none; width: 64px; color: var(--text-muted); }
  .stat b { flex: none; width: 52px; text-align: right; color: var(--accent); }
  .trackbar {
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: var(--accent-soft);
    overflow: hidden;
    border: 1px solid var(--card-border);
  }
  .trackbar i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), #10b981); }

  .fortune { margin: 0; font-size: 13px; line-height: 2; }
  .comment { color: var(--text-faint); }

  /* 服务 */
  .links { display: flex; gap: 22px; flex-wrap: wrap; font-size: 12.5px; }
  .svc { color: var(--text); }
  .svc:hover { color: var(--accent); }
  .ok { color: var(--accent); }
  .warn { color: var(--accent-2); }

  .exit { margin-top: 4px; }
  .muted { color: var(--text-muted); }
  .foot { text-align: center; margin-top: 26px; font-size: 12px; color: var(--text-faint); }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, socials } from "../../config/site";

/* 设计稿 V5 —— 融合定稿候选：V1 玻璃 Bento 布局 × 浅色系默认
   明暗双主题：右上角一键切换，localStorage 记忆，?theme=dark 可直链暗色 */

// 日历样例：2026 年 9 月（今天 24 日高亮）
const first = new Date(2026, 8, 1);
const startCol = (first.getDay() + 6) % 7;
const daysInMonth = new Date(2026, 9, 0).getDate();
const cells = [
  ...Array.from({ length: startCol }, () => 0),
  ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
const today = 24;

const posts = [
  {
    title: "把博客从 Quartz 搬到 Astro 的心路历程",
    date: "09-24",
    tag: "建站",
    excerpt: "与其在别人的框架里缝缝补补，不如自己搓一个……",
  },
  {
    title: "量化看板搭建记录：从零到实盘",
    date: "09-12",
    tag: "量化",
    excerpt: "数据源、回测框架与看板选型的踩坑全记录……",
  },
];

const events = [
  { icon: "⬆️", text: "push 到 zmdld11/MyBlog：3 commits", time: "2 小时前" },
  { icon: "⭐", text: "star 了 matsuzaka-yuki/Mizuki", time: "5 小时前" },
  { icon: "🦑", text: "在 zmdld11/dev-workflow 开了 issue #12", time: "昨天" },
  { icon: "⬆️", text: "push 到 zmdld11/dev-workflow：1 commit", time: "前天" },
  { icon: "🎉", text: "创建了新仓库 zmdld11/potato-sync", time: "3 天前" },
];

const nav = [
  { label: "V1 玻璃Bento", href: "/preview/v1" },
  { label: "V2 杂志", href: "/preview/v2" },
  { label: "V3 软糖", href: "/preview/v3" },
  { label: "V4 终端", href: "/preview/v4" },
  { label: "V5 融合✦", href: "/preview/v5", current: true },
];
---

<BaseLayout title={`V5 融合 · ${site.title}`} colorScheme="light" themeInit previewNav={nav}>
  <div class="page">
    <!-- 极光背景：浅色为粉紫蓝软雾，暗色回落到 V1 深空 -->
    <div class="aurora" aria-hidden="true">
      <div class="blob b1"></div>
      <div class="blob b2"></div>
      <div class="blob b3"></div>
    </div>

    <main class="wrap">
      <header class="topbar">
        <span class="logo accent-text">{site.title}</span>
        <nav class="links">
          <a href="/">首页</a><a href="/">归档</a><a href="/">标签</a><a href="/">关于</a>
          <button class="theme-btn" id="v5-theme-toggle" aria-label="切换明暗模式" title="切换明暗模式">🌙</button>
        </nav>
      </header>

      <section class="bento">
        <!-- 身份卡 -->
        <article class="card card-hover sp4 identity">
          <div class="avatar accent-text">Z</div>
          <h1>{site.author}</h1>
          <p class="bio">{site.subtitle}</p>
          <div class="row">
            {socials.map((s) => (
              <a class="chip" href={s.url} target="_blank" rel="noopener">{s.label}</a>
            ))}
          </div>
        </article>

        <!-- 时钟 -->
        <article class="card card-hover sp4 clock">
          <header class="card-head">现在 <span class="badge">样例</span></header>
          <div class="time" id="v5-clock">--:--:--</div>
          <p class="date" id="v5-date">载入中…</p>
        </article>

        <!-- 日历 -->
        <article class="card card-hover sp4 calendar">
          <header class="card-head">2026 年 9 月 <span class="badge">样例</span></header>
          <div class="cal-grid">
            {["一", "二", "三", "四", "五", "六", "日"].map((d) => (
              <span class="cal-head">{d}</span>
            ))}
            {cells.map((d) => (
              <span class:list={["cal-day", { today: d === today, empty: d === 0 }]}>
                {d === 0 ? "" : d}
              </span>
            ))}
          </div>
        </article>

        <!-- GitHub 动态 -->
        <article class="card card-hover sp6 github">
          <header class="card-head">GitHub 动态 <span class="badge">样例</span></header>
          <ul>
            {
              events.map((e) => (
                <li>
                  <span class="icon">{e.icon}</span>
                  <span class="text">{e.text}</span>
                  <span class="time">{e.time}</span>
                </li>
              ))
            }
          </ul>
        </article>

        <!-- 最新文章 -->
        <article class="card card-hover sp6 posts">
          <header class="card-head">最新文章</header>
          {
            posts.map((p) => (
              <a class="post" href="/">
                <div class="post-cover accent-text" aria-hidden="true">✦</div>
                <div class="post-body">
                  <h3>{p.title}</h3>
                  <p>{p.excerpt}</p>
                  <span class="meta">{p.date} · {p.tag}</span>
                </div>
              </a>
            ))
          }
        </article>

        <!-- 音乐播放器 -->
        <article class="card card-hover sp4 music">
          <header class="card-head">正在播放 <span class="badge">样例</span></header>
          <div class="player">
            <div class="cover accent-text">♪</div>
            <div class="track">
              <strong>Sample Track</strong>
              <span class="muted">未知艺术家</span>
              <div class="bar"><i></i></div>
              <span class="timecode muted">01:24 / 04:05</span>
            </div>
            <div class="controls"><button>⏮</button><button class="play">▶</button><button>⏭</button></div>
          </div>
        </article>

        <!-- 一言 -->
        <article class="card card-hover sp4 hitokoto">
          <header class="card-head">一言 <span class="badge">样例</span></header>
          <blockquote>“我们听取所有的声音，然后走自己选的路。”</blockquote>
          <span class="muted">—— 佚名</span>
        </article>

        <!-- 统计 -->
        <article class="card card-hover sp4 stats">
          <header class="card-head">小站统计 <span class="badge">样例</span></header>
          <div class="stat-row">
            <div><b>20</b><span class="muted">文章</span></div>
            <div><b>1,024</b><span class="muted">访客</span></div>
            <div><b>212</b><span class="muted">运行天数</span></div>
          </div>
        </article>
      </section>

      <footer class="foot muted">© 2026 {site.author} · 样例设计稿 V5（V1×V3 融合 · 浅色默认） · 数据均为占位</footer>
    </main>
  </div>
</BaseLayout>

<script>
  const t = document.getElementById("v5-clock");
  const d = document.getElementById("v5-date");
  if (t && d) {
    const tick = () => {
      const now = new Date();
      t.textContent = now.toLocaleTimeString("zh-CN", { hour12: false });
      d.textContent = now.toLocaleDateString("zh-CN", {
        year: "numeric",
        month: "long",
        day: "numeric",
        weekday: "long",
      });
    };
    tick();
    setInterval(tick, 1000);
  }

  const btn = document.getElementById("v5-theme-toggle");
  const paint = () => {
    btn.textContent = document.documentElement.dataset.theme === "dark" ? "☀️" : "🌙";
  };
  paint();
  btn?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    paint();
  });
</script>

<style>
  .page {
    min-height: 100vh;
    position: relative;
    overflow-x: clip;
  }

  /* 极光背景（浅色默认；暗色经 :global 覆盖） */
  .aurora {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--bg);
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
  }
  .b1 { width: 520px; height: 520px; top: -160px; left: -120px; background: #d8ccff; }
  .b2 { width: 460px; height: 460px; top: 10%; right: -140px; background: #b5e8ff; }
  .b3 { width: 420px; height: 420px; bottom: -180px; left: 30%; background: #ffd9e8; opacity: 0.55; }

  :global(html[data-theme="dark"]) .b1 { background: #6d28d9; opacity: 0.5; }
  :global(html[data-theme="dark"]) .b2 { background: #0e7490; opacity: 0.5; }
  :global(html[data-theme="dark"]) .b3 { background: #4c1d95; opacity: 0.4; }

  /* 浅色模式下玻璃感更明显一点：卡片更白、阴影更轻（暗色回落到全局深色玻璃令牌） */
  :global(html:not([data-theme="dark"])) .page {
    --card: rgba(255, 255, 255, 0.66);
    --shadow: 0 10px 30px rgba(108, 92, 231, 0.1);
  }

  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 28px 24px 72px;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 26px;
  }
  .logo { font-weight: 800; font-size: 18px; }
  .links { display: flex; gap: 22px; font-size: 14px; align-items: center; }
  .links a { color: var(--text-muted); transition: color 0.2s; }
  .links a:hover { color: var(--text); }
  .theme-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--card-border);
    background: var(--card);
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .theme-btn:hover {
    transform: rotate(20deg) scale(1.06);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .card { padding: 20px; }
  .card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 14px;
    letter-spacing: 0.05em;
  }
  .badge {
    font-size: 10px;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }

  /* 身份卡 */
  .identity { display: flex; flex-direction: column; justify-content: center; }
  .avatar {
    width: 68px;
    height: 68px;
    border-radius: 22px;
    display: grid;
    place-items: center;
    font-size: 30px;
    font-weight: 800;
    color: var(--on-accent);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    margin-bottom: 14px;
  }
  .identity h1 { font-size: 24px; margin: 0 0 6px; }
  .bio { color: var(--text-muted); font-size: 14px; margin: 0 0 16px; }
  .row { display: flex; gap: 8px; flex-wrap: wrap; }

  /* 时钟 */
  .clock { display: flex; flex-direction: column; justify-content: center; }
  .time {
    font-size: 44px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .date { margin: 8px 0 0; font-size: 13px; }

  /* 日历 */
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    text-align: center;
    font-size: 12px;
  }
  .cal-head { color: var(--text-faint); padding: 4px 0; }
  .cal-day {
    padding: 4px 0;
    border-radius: 8px;
    color: var(--text-muted);
  }
  .cal-day.today {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--on-accent);
    font-weight: 700;
  }

  /* GitHub 动态 */
  .github ul { list-style: none; margin: 0; padding: 0; }
  .github li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--card-border);
    font-size: 13.5px;
  }
  .github li:last-child { border-bottom: none; }
  .github .icon { flex: none; }
  .github .text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .github .time { flex: none; color: var(--text-faint); font-size: 12px; }

  /* 文章 */
  .posts { display: flex; flex-direction: column; gap: 12px; }
  .post {
    display: flex;
    gap: 14px;
    padding: 12px;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    transition: border-color 0.2s, background 0.2s;
  }
  .post:hover { border-color: var(--card-border); background: var(--accent-soft); }
  .post-cover {
    flex: none;
    width: 58px;
    height: 58px;
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    font-size: 22px;
    color: var(--on-accent);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }
  .post-body h3 { font-size: 15px; margin: 0 0 4px; }
  .post-body p {
    margin: 0 0 6px;
    font-size: 12.5px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .meta { font-size: 12px; color: var(--text-faint); }

  /* 播放器 */
  .player { display: flex; align-items: center; gap: 14px; }
  .cover {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    display: grid;
    place-items: center;
    font-size: 26px;
    color: var(--on-accent);
    background: linear-gradient(135deg, var(--accent-2), var(--accent));
  }
  .track { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5px; font-size: 13px; }
  .bar { height: 5px; border-radius: 999px; background: var(--card-border); overflow: hidden; }
  .bar i { display: block; width: 35%; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-2)); border-radius: inherit; }
  .timecode { font-size: 11px; }
  .controls { display: flex; gap: 6px; }
  .controls button {
    width: 34px; height: 34px;
    border-radius: 50%;
    border: 1px solid var(--card-border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    font-size: 12px;
  }
  .controls .play {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--on-accent);
    border: none;
  }

  /* 一言 */
  .hitokoto blockquote {
    margin: 0 0 10px;
    font-size: 15px;
    line-height: 1.85;
  }

  /* 统计 */
  .stats { display: flex; flex-direction: column; justify-content: center; }
  .stat-row { display: flex; justify-content: space-around; text-align: center; }
  .stat-row b { display: block; font-size: 24px; margin-bottom: 4px; }
  .stat-row span { font-size: 12px; }

  .foot { text-align: center; margin-top: 36px; font-size: 12.5px; }
</style>

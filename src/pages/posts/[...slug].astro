---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection, render } from "astro:content";
import { site } from "../../config/site";
import { fmtDate } from "../../lib/post-utils";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, pubDate, tags, category } = entry.data;
---

<SiteLayout title={`${title} · ${site.title}`} description={entry.data.description}>
  {
    /* ?eager 调试参数：强制立即加载全部正文图（截图/打印用，正常访问不受影响） */
  }
  <script is:inline>
    if (new URLSearchParams(location.search).has("eager")) {
      addEventListener("load", () => {
        document.querySelectorAll(".prose img").forEach((img) => {
          img.loading = "eager";
          img.decoding = "sync";
        });
      });
    }
  </script>
  <article class="post-page">
    <header class="post-head card">
      <a class="back" href="/archive/">← 返回归档</a>
      <h1>{title}</h1>
      <div class="meta">
        <span>{fmtDate(pubDate)}</span>
        {category && <a class="chip" href={`/tags/${category}/`}>{category}</a>}
        {tags.map((t) => <a class="chip" href={`/tags/${t}/`}>#{t}</a>)}
      </div>
    </header>

    <div class="prose card">
      <Content />
    </div>

    <nav class="pn">
      {
        prev ? (
          <a class="card card-hover pn-item" href={`/posts/${prev.id}/`}>
            <span class="pn-label">较新一篇</span>
            <span class="pn-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="card card-hover pn-item right" href={`/posts/${next.id}/`}>
            <span class="pn-label">较旧一篇</span>
            <span class="pn-title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</SiteLayout>

<style>
  .post-page {
    max-width: 820px;
    margin: 0 auto;
  }

  .post-head { padding: 26px 30px 22px; margin-bottom: 18px; }
  .back { font-size: 13px; color: var(--text-muted); }
  .back:hover { color: var(--accent); }
  .post-head h1 {
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.4;
    margin: 12px 0 14px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--text-faint);
  }

  /* 中文正文排版 */
  .prose {
    padding: 30px 34px;
    font-size: 15.5px;
    line-height: 1.95;
    color: var(--text);
  }
  .prose :global(h1), .prose :global(h2), .prose :global(h3), .prose :global(h4) {
    line-height: 1.45;
    margin: 1.6em 0 0.7em;
    font-weight: 700;
  }
  .prose :global(h1) { font-size: 1.5em; }
  .prose :global(h2) {
    font-size: 1.28em;
    padding-left: 10px;
    border-left: 4px solid var(--accent);
  }
  .prose :global(h3) { font-size: 1.12em; }
  .prose :global(p) { margin: 0.9em 0; }
  .prose :global(a) {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .prose :global(a:hover) { border-bottom-color: var(--accent); }
  .prose :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow);
    margin: 1.2em auto;
    display: block;
  }
  .prose :global(blockquote) {
    margin: 1.2em 0;
    padding: 0.6em 1.1em;
    border-left: 4px solid var(--accent-2);
    background: var(--accent-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-muted);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--accent-soft);
    padding: 2px 6px;
    border-radius: 6px;
  }
  .prose :global(pre) {
    background: var(--card-solid);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 16px 18px;
    overflow-x: auto;
    line-height: 1.7;
    font-size: 13.5px;
  }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5em; margin: 0.9em 0; }
  .prose :global(li) { margin: 0.35em 0; }
  .prose :global(hr) {
    border: none;
    border-top: 1px dashed var(--card-border);
    margin: 2em 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.2em 0;
    font-size: 14px;
  }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--card-border);
    padding: 8px 12px;
    text-align: left;
  }
  .prose :global(th) { background: var(--accent-soft); }

  .pn {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
  }
  .pn-item {
    flex: 1;
    min-width: 0;
    max-width: 48%;
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pn-item.right { text-align: right; }
  .pn-label { font-size: 12px; color: var(--text-faint); }
  .pn-title {
    font-size: 14px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .prose { padding: 22px 20px; }
    .post-head { padding: 20px 20px 18px; }
  }
</style>

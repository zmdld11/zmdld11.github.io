[Unit]
Description=Blog OAuth gateway (zmdld11.github.io)
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/blog-gateway
EnvironmentFile=/home/admin/blog-gateway/.env
ExecStart=/usr/bin/node /home/admin/blog-gateway/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
